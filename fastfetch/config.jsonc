// kawt / fastfetch: the starting point (black). install.sh copies it to
// ~/.local/state/kawt/theme/fastfetch.jsonc and links ~/.config/fastfetch/config.jsonc there;
// once kawt runs it rewrites that copy in the current theme colors (utils/themegen.js).
// Safe to screenshot: the system's own logo, no user@host, laptop model or addresses.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 9
    },
    "color": {
      "keys": "38;2;142;139;132",
      "title": "38;2;226;35;26",
      "output": "38;2;222;220;214",
      "separator": "38;2;142;139;132"
    },
    "percent": {
      "type": 2,
      "color": {
        "green": "38;2;222;220;214",
        "yellow": "38;2;226;35;26",
        "red": "38;2;226;35;26"
      }
    },
    "bar": {
      "width": 12,
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "border": {
        "left": "[",
        "right": "]"
      },
      "color": {
        "elapsed": "38;2;226;35;26",
        "total": "38;2;142;139;132",
        "border": "38;2;142;139;132"
      }
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "kawt",
      "format": "· {name}",
      "keyWidth": 5,
      "keyColor": "38;2;226;35;26",
      "outputColor": "38;2;142;139;132"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────────",
      "outputColor": "38;2;142;139;132"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "kernel",
      "key": "kernel"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "packages"
    },
    {
      "type": "wm",
      "key": "wm"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    {
      "type": "terminal",
      "key": "terminal"
    },
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "gpu",
      "key": "gpu"
    },
    {
      "type": "memory",
      "key": "memory"
    },
    {
      "type": "disk",
      "key": "disk /",
      "folders": "/"
    },
    {
      "type": "terminalfont",
      "key": "font"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 0
    }
  ]
}
