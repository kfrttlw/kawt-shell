// kawt / fastfetch: the starting point (mono-dark). install.sh copies it to
// ~/.local/state/kawt/theme/fastfetch.jsonc and links ~/.config/fastfetch/config.jsonc there;
// once kawt runs it rewrites that copy in the current theme colors (utils/themegen.js).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1  ____________\n | $2>_$1         |\n |            |\n |____________|\n/ :::::$3●$1:::::: \\\n\\______________/",
    "color": {
      "1": "38;2;114;114;112",
      "2": "38;2;230;230;226",
      "3": "38;2;226;35;26"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "key": {
      "width": 7
    },
    "color": {
      "keys": "38;2;114;114;112",
      "title": "38;2;230;230;226",
      "output": "38;2;230;230;226",
      "separator": "38;2;114;114;112"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;230;230;226",
        "yellow": "38;2;230;230;226",
        "red": "38;2;201;86;74"
      }
    },
    "bar": {
      "width": 12,
      "char": {
        "elapsed": "#",
        "total": "-"
      },
      "border": {
        "left": "[",
        "right": "]"
      },
      "color": {
        "elapsed": "38;2;230;230;226",
        "total": "38;2;114;114;112",
        "border": "38;2;114;114;112"
      }
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "host",
      "key": "host"
    },
    {
      "type": "kernel",
      "key": "kern"
    },
    {
      "type": "uptime",
      "key": "up"
    },
    {
      "type": "packages",
      "key": "pkgs"
    },
    {
      "type": "wm",
      "key": "wm"
    },
    {
      "type": "terminal",
      "key": "term"
    },
    {
      "type": "shell",
      "key": "shell"
    },
    {
      "type": "cpu",
      "key": "cpu"
    },
    {
      "type": "gpu",
      "key": "gpu"
    },
    {
      "type": "memory",
      "key": "mem"
    },
    {
      "type": "disk",
      "key": "disk",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "bat"
    },
    {
      "type": "custom",
      "key": "kawt",
      "format": "mono-dark · soft terminal colors"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 0
    }
  ]
}
