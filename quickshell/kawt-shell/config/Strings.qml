pragma Singleton
import QtQuick
import Quickshell

// kawt's words, in english and russian: Strings.t("key"). English unless Settings.language is
// "ru" (settings -> look -> language); the system's language doesn't change it. A key missing in one
// language shows the other's, a key missing in both shows itself.
// New words go here, not into the panels, so both languages stay whole.
Singleton {
    id: root

    readonly property string lang: Settings.language === "ru" ? "ru" : "en"
    readonly property bool ru: lang === "ru"

    function t(key: string): string {
        const d = ru ? ruWords : enWords;
        return d[key] ?? enWords[key] ?? ruWords[key] ?? key;
    }

    // "4 days", "4 дня": n and its word in the form it takes (russian has three: one, few,
    // many; the words are key_one, key_few, key_many)
    function count(n: int, key: string): string {
        let form = n === 1 ? "one" : "many";
        if (ru) {
            const a = n % 10, b = n % 100;
            form = a === 1 && b !== 11 ? "one" : a >= 2 && a <= 4 && (b < 12 || b > 14) ? "few" : "many";
        }
        return `${n} ${t(`${key}_${form}`)}`;
    }

